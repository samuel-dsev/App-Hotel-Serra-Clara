
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AppHotel.Models"
             x:Class="AppHotel.Views.ResumoPage"
             x:DataType="models:ResumoEstadia"
             Title="Resumo da estadia">
    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="{StaticResource Verde}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="20,10" MaximumWidthRequest="1160">
                <Button Text="‹ Voltar" Clicked="Voltar" Style="{StaticResource BotaoCabecalho}" />
                <Label Grid.Column="1" Text="App Hotel" TextColor="White" FontFamily="HotelSerif"
                       FontSize="24" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,24,18,30" Spacing="16" MaximumWidthRequest="600">
                <Label Text="Resumo da estadia" Style="{StaticResource Titulo}" SemanticProperties.HeadingLevel="Level1" />
                <Border Style="{StaticResource CartaoPadrao}">
                    <VerticalStackLayout Spacing="17">
                        <Label Text="{Binding Suite.Nome}" FontFamily="HotelSerif" FontSize="29"
                               SemanticProperties.HeadingLevel="Level2" />
                        <BoxView HeightRequest="1" Color="{StaticResource Linha}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="16">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="CHECK-IN" Style="{StaticResource Secao}" />
                                <Label Text="{Binding Entrada, StringFormat='{0:dd/MM/yyyy}'}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="CHECK-OUT" Style="{StaticResource Secao}" />
                                <Label Text="{Binding Saida, StringFormat='{0:dd/MM/yyyy}'}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="5">
                                <Label Text="ADULTOS" Style="{StaticResource Secao}" />
                                <Label Text="{Binding Adultos}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                <Label Text="CRIANÇAS" Style="{StaticResource Secao}" />
                                <Label Text="{Binding Criancas}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Linha}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="DURAÇÃO" Style="{StaticResource Secao}" />
                                <Label Text="{Binding Duracao}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="DIÁRIA DA SUÍTE" Style="{StaticResource Secao}" />
                                <Label Text="{Binding Suite.DiariaFormatada}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Verde}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="22,16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="TOTAL ESTIMADO" Style="{StaticResource Secao}" TextColor="{StaticResource Areia}" />
                        <Label Text="{Binding TotalFormatado}" FontFamily="HotelSerif" FontSize="36" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Editar estadia" Clicked="Voltar" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
