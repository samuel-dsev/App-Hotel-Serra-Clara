
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Papel">#F5F2E9</Color>
            <Color x:Key="Cartao">#FFFCF6</Color>
            <Color x:Key="Verde">#173B32</Color>
            <Color x:Key="Texto">#20352B</Color>
            <Color x:Key="Secundario">#526459</Color>
            <Color x:Key="Linha">#DDDCD0</Color>
            <Color x:Key="Areia">#E8D1A8</Color>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Papel}" />
                <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="Titulo" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Verde}" />
                <Setter Property="FontFamily" Value="HotelSerif" />
                <Setter Property="FontSize" Value="38" />
            </Style>

            <Style x:Key="Secao" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Verde}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.3" />
            </Style>

            <Style x:Key="CartaoPadrao" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Cartao}" />
                <Setter Property="Stroke" Value="{StaticResource Linha}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
                <Setter Property="Padding" Value="22" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Verde}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="Padding" Value="16,8" />
            </Style>

            <Style x:Key="BotaoCabecalho" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BorderColor" Value="#84988E" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="Padding" Value="14,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
